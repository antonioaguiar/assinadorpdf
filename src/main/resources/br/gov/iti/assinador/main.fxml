<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.shape.Rectangle?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.eti.aaguiar.assinador.controller.MainController"
            stylesheets="@style.css" prefWidth="1100.0" prefHeight="780.0">

    <!-- TOP HEADER -->
    <top>
        <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="10">
            <VBox>
                <Text styleClass="header-title" text="Assinador Digital de PDF" />
                <Text styleClass="header-subtitle" text="Padrão ICP-Brasil (A1 e A3) - Compatível com macOS, Linux &amp; Windows" />
            </VBox>
        </HBox>
    </top>

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox spacing="15" prefWidth="360.0" style="-fx-background-color: #edf2f7; -fx-border-color: #cbd5e0; -fx-border-width: 0 1 0 0;">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15" />
            </padding>

            <!-- CARD 1: CERTIFICADO -->
            <VBox styleClass="card-panel" spacing="10">
                <Label styleClass="card-title" text="1. Certificado Digital" />
                
                <HBox spacing="10">
                    <RadioButton fx:id="rbA3" text="Nativo SO (A3 / Keychain)" selected="true">
                        <toggleGroup>
                            <ToggleGroup fx:id="certTypeGroup" />
                        </toggleGroup>
                    </RadioButton>
                    <RadioButton fx:id="rbA1" text="Arquivo A1 (.pfx)" toggleGroup="$certTypeGroup" />
                </HBox>

                <!-- Seção A3 -->
                <VBox fx:id="vboxA3" spacing="8">
                    <Label text="Certificados Disponíveis:" styleClass="label-info" />
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <ComboBox fx:id="cbA3Certs" promptText="Selecione um certificado" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                        <Button fx:id="btnRefreshA3" text="🔄" styleClass="button-secondary" onAction="#handleRefreshA3" />
                    </HBox>
                </VBox>

                <!-- Seção A1 -->
                <VBox fx:id="vboxA1" spacing="8" managed="false" visible="false">
                    <Label text="Arquivo do Certificado A1:" styleClass="label-info" />
                    <HBox spacing="8">
                        <Button text="Selecionar PFX" styleClass="button-secondary" onAction="#handleSelectA1File" />
                        <Label fx:id="lblA1Path" text="Nenhum arquivo selecionado" styleClass="label-info" wrapText="true" HBox.hgrow="ALWAYS" maxWidth="150" />
                    </HBox>
                    <Label text="Senha:" styleClass="label-info" />
                    <HBox spacing="8">
                        <PasswordField fx:id="pfA1Password" promptText="Digite a senha" HBox.hgrow="ALWAYS" />
                        <Button text="Carregar" styleClass="button-primary" onAction="#handleLoadA1" />
                    </HBox>
                </VBox>

                <!-- Informações do Certificado Ativo -->
                <VBox fx:id="vboxCertInfo" spacing="5" style="-fx-background-color: #f7fafc; -fx-padding: 8; -fx-background-radius: 4; -fx-border-color: #e2e8f0; -fx-border-radius: 4;">
                    <Label text="Informações do Certificado:" style="-fx-font-weight: bold; -fx-text-fill: #4a5568;" />
                    <HBox>
                        <Label text="Nome: " styleClass="label-info" />
                        <Label fx:id="lblCertName" text="Nenhum certificado ativo" styleClass="label-value" wrapText="true" maxWidth="230"/>
                    </HBox>
                    <HBox>
                        <Label fx:id="lblCpfTitle" text="CPF: " styleClass="label-info" />
                        <Label fx:id="lblCertCpf" text="N/D" styleClass="label-value" />
                    </HBox>
                    <HBox>
                        <Label text="Validade: " styleClass="label-info" />
                        <Label fx:id="lblCertExpiry" text="N/D" styleClass="label-value" />
                    </HBox>
                </VBox>

                <!-- Nova Seção para Anexar Imagem -->
                <VBox spacing="8" style="-fx-border-color: #e2e8f0; -fx-border-width: 1 0 0 0; -fx-padding: 10 0 0 0;">
                    <Label text="Imagem/Logo (Opcional):" styleClass="label-info" style="-fx-font-weight: bold;" />
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Button text="Selecionar Imagem" styleClass="button-secondary" onAction="#handleSelectImage" />
                        <Button text="X" styleClass="button-secondary" style="-fx-text-fill: red;" onAction="#handleClearImage" />
                    </HBox>
                    <Label fx:id="lblImagePath" text="Nenhuma imagem selecionada" styleClass="label-info" wrapText="true" maxWidth="300" />
                </VBox>
            </VBox>

            <!-- CARD 2: DOCUMENTO PDF -->
            <VBox styleClass="card-panel" spacing="10">
                <Label styleClass="card-title" text="2. Arquivo PDF" />
                <Button text="Selecionar Documento PDF" styleClass="button-primary" maxWidth="Infinity" onAction="#handleSelectPdf" />
                <HBox alignment="CENTER_LEFT" spacing="5">
                    <Label text="Arquivo: " styleClass="label-info" />
                    <Label fx:id="lblPdfName" text="Nenhum arquivo carregado" styleClass="label-value" wrapText="true" maxWidth="240" />
                </HBox>
            </VBox>

            <!-- CARD 3: POSICIONAMENTO DA ASSINATURA -->
            <VBox styleClass="card-panel" spacing="10" VBox.vgrow="ALWAYS">
                <Label styleClass="card-title" text="3. Posição da Assinatura" />
                <Label text="Instruções:" style="-fx-font-weight: bold; -fx-text-fill: #4a5568;" />
                <Label text="1. Navegue até a página desejada no visualizador ao lado.&#10;2. Clique sobre o local da página onde deseja inserir a assinatura.&#10;3. O retângulo verde indicará a posição exata." 
                       wrapText="true" styleClass="label-info" />
                
                <Separator />
                
                <VBox spacing="5" style="-fx-background-color: #f7fafc; -fx-padding: 8; -fx-background-radius: 4;">
                    <HBox>
                        <Label text="Página da Assinatura: " styleClass="label-info" />
                        <Label fx:id="lblSignPage" text="Nenhuma" styleClass="label-value" />
                    </HBox>
                    <HBox>
                        <Label text="Coordenada X (PDF): " styleClass="label-info" />
                        <Label fx:id="lblSignX" text="-" styleClass="label-value" />
                    </HBox>
                    <HBox>
                        <Label text="Coordenada Y (PDF): " styleClass="label-info" />
                        <Label fx:id="lblSignY" text="-" styleClass="label-value" />
                    </HBox>
                </VBox>

                <VBox spacing="10" alignment="BOTTOM_CENTER" VBox.vgrow="ALWAYS">
                    <Button fx:id="btnSign" text="Assinar Digitalmente" styleClass="button-success" maxWidth="Infinity" 
                            disable="true" onAction="#handleSignDocument" />
                </VBox>
            </VBox>
        </VBox>
    </left>

    <!-- CENTER PREVIEW AREA -->
    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15" />
            </padding>
            
            <!-- Barra de Controles do PDF -->
            <HBox spacing="15" alignment="CENTER" style="-fx-background-color: white; -fx-padding: 8; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
                <Button fx:id="btnPrevPage" text="◀ Anterior" styleClass="button-secondary" onAction="#handlePrevPage" disable="true" />
                <Label fx:id="lblPageIndicator" text="Página: 0 / 0" style="-fx-font-weight: bold; -fx-text-fill: #4a5568;" />
                <Button fx:id="btnNextPage" text="Próxima ▶" styleClass="button-secondary" onAction="#handleNextPage" disable="true" />
            </HBox>

            <!-- Viewer Container -->
            <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true" fitToHeight="false" 
                        style="-fx-background: #718096; -fx-border-color: #cbd5e0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10;">
                <Pane fx:id="pdfPane">
                    <ImageView fx:id="pdfImageView" pickOnBounds="true" preserveRatio="true" styleClass="pdf-page-view" 
                               onMouseClicked="#handlePdfClick" onMouseDragged="#handlePdfClick" />
                    
                    <!-- Container do posicionamento visual da assinatura (invisível por padrão) -->
                    <StackPane fx:id="signatureBox" visible="false" alignment="CENTER_LEFT" mouseTransparent="true"
                               style="-fx-background-color: rgba(255, 255, 255, 0.9); -fx-border-color: #e53e3e; -fx-border-width: 2;">
                        <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-padding: 5;">
                            <ImageView fx:id="signaturePreviewImage" fitWidth="40" fitHeight="40" preserveRatio="true" managed="false" visible="false"/>
                            <VBox alignment="CENTER_LEFT" spacing="2">
                                <Label text="Assinado digitalmente por:" style="-fx-font-size: 10px; -fx-text-fill: #4a5568;" />
                                <Label fx:id="lblPreviewName" text="NOME DO ASSINANTE" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #2d3748;" />
                                <Label fx:id="lblPreviewDoc" text="CPF: 000.000.000-00" style="-fx-font-size: 10px; -fx-text-fill: #4a5568;" />
                            </VBox>
                        </HBox>
                    </StackPane>
                </Pane>
            </ScrollPane>
        </VBox>
    </center>

    <!-- BOTTOM STATUS BAR -->
    <bottom>
        <VBox>
            <HBox style="-fx-background-color: #e2e8f0; -fx-padding: 5 15; -fx-border-color: #cbd5e0; -fx-border-width: 1 0 0 0;" alignment="CENTER_LEFT">
                <Label fx:id="lblStatus" text="Pronto." style="-fx-text-fill: #4a5568; -fx-font-size: 11px;" />
            </HBox>
            <HBox style="-fx-background-color: #f7fafc; -fx-padding: 5 15;" alignment="CENTER_RIGHT">
                <Hyperlink text="Validar PDF no ITI (https://validar.iti.gov.br/index.html)" onAction="#handleOpenITI" style="-fx-font-size: 11px;"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
